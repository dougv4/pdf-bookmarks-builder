{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Bookmarks Builder",
  "version": "0.1.0",
  "identifier": "com.dougv4.pdfbookmarksbuilder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Bookmarks Builder",
        "width": 1440,
        "height": 980,
        "resizable": true,
        "minWidth": 1100,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../resources/**/*"
    ]
  }
}
